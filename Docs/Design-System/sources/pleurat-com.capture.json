{
  "benchmark": "pleurat-com",
  "type": "design",
  "baseUrl": "https://www.pleurat.com",
  "defaults": {
    "viewports": [
      "desktop"
    ],
    "scale": 2,
    "padding": 16,
    "waitMs": 400,
    "timeoutMs": 45000
  },
  "reveal": {
    "patchIntersectionObserver": true,
    "css": ".sv-rv, .sv-lines, [data-reveal] { opacity: 1 !important; transform: none !important; visibility: visible !important; } .sv-rv > *, .sv-lines > * { opacity: 1 !important; transform: none !important; }",
    "scrollThrough": true
  },
  "stylesheets": {
    "match": [
      "/assets/index-",
      "/assets/theme-"
    ],
    "rootSelectors": [
      ":root",
      "html",
      "[data-theme"
    ]
  },
  "tokenMap": {
    "--bg": "color.theme.bg",
    "--band-paper": "color.theme.band-paper",
    "--band-ground": "color.theme.band-ground",
    "--ink": "color.theme.ink",
    "--ink-2": "color.theme.ink-2",
    "--ink-3": "color.theme.ink-3",
    "--ink-4": "color.theme.ink-4",
    "--line": "color.theme.line",
    "--line-2": "color.theme.line-2",
    "--color-accent": "color.theme.accent",
    "--color-accent-2": "color.theme.accent-2",
    "--lime": "color.theme.lime",
    "--focus-ring": "color.theme.focus-ring",
    "--sans": "font.family.theme-sans",
    "--mono": "font.family.theme-mono",
    "--fs-micro": "font.size.theme.micro",
    "--fs-2xs": "font.size.theme.2xs",
    "--fs-xs": "font.size.theme.xs",
    "--fs-sm": "font.size.theme.sm",
    "--fs-md": "font.size.theme.md",
    "--fs-lg": "font.size.theme.lg",
    "--fs-xl": "font.size.theme.xl",
    "--fs-sub": "font.size.theme.sub",
    "--fs-lead": "font.size.theme.lead",
    "--fs-h5": "font.size.theme.h5",
    "--fs-h4": "font.size.theme.h4",
    "--fs-h3": "font.size.theme.h3",
    "--fs-h2": "font.size.theme.h2",
    "--fs-h1": "font.size.theme.h1",
    "--fs-display": "font.size.theme.display",
    "--fs-display-lg": "font.size.theme.display-lg",
    "--fs-num": "font.size.num",
    "--fs-num-lg": "font.size.num-lg",
    "--fs-ghost": "font.size.ghost",
    "--sec-pad": "space.theme.section",
    "--sec-pad-sm": "space.theme.section-sm",
    "--ease": "motion.ease.standard",
    "--ease-spring": "motion.ease.spring",
    "--dur-1": "motion.duration.fast",
    "--dur-2": "motion.duration.base",
    "--dur-3": "motion.duration.slow",
    "--lift": "motion.lift",
    "--hx-radius": "radius.theme.card",
    "--radius-pill": "radius.theme.pill",
    "--r-media": "radius.theme.media",
    "--ctl-h": "size.theme.control-h",
    "--ctl-h-sm": "size.theme.control-h-sm",
    "--ctl-pad-x": "size.theme.control-pad-x",
    "--ctl-pad-y": "size.theme.control-pad-y"
  },
  "measure": [
    {
      "path": "color.ground",
      "selector": "body",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.paper",
      "selector": ".site-root",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.panel",
      "selector": ".sv-console",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.ink",
      "selector": "h1, .sv-card h3",
      "prop": "color",
      "type": "color"
    },
    {
      "path": "color.ink-2",
      "selector": ".sv-hero-right p, .sv-head p, .sv-card p",
      "prop": "color",
      "type": "color"
    },
    {
      "path": "color.ink-3",
      "selector": ".sv-card .ix, .sv-cn-foot span",
      "prop": "color",
      "type": "color"
    },
    {
      "path": "color.headline-muted",
      "selector": "h1 .sv-dim, h2 .sv-dim",
      "prop": "color",
      "type": "color"
    },
    {
      "path": "color.brand",
      "selector": ".sv-btn--amber",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.on-brand",
      "selector": ".sv-btn--amber",
      "prop": "color",
      "type": "color"
    },
    {
      "path": "color.tag",
      "selector": ".sv-cn-bar",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.console",
      "selector": ".sv-cn-log, .sv-console pre, .sv-console code",
      "prop": "backgroundColor",
      "type": "color"
    },
    {
      "path": "color.line",
      "selector": ".sv-card",
      "prop": "borderTopColor",
      "type": "color"
    },
    {
      "path": "color.line-2",
      "selector": ".sv-ruled",
      "prop": "borderTopColor",
      "type": "color"
    },
    {
      "path": "font.family.sans",
      "selector": "body",
      "prop": "fontFamily",
      "type": "fontFamily"
    },
    {
      "path": "font.family.mono",
      "selector": ".sv-cn-foot span, .sv-card .ix",
      "prop": "fontFamily",
      "type": "fontFamily"
    },
    {
      "path": "font.size.h1",
      "selector": "h1",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.h2",
      "selector": ".sv-head h2",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.h3",
      "selector": ".sv-card h3",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.body",
      "selector": ".sv-hero-right p, .sv-head p",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.card-body",
      "selector": ".sv-card p",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.caption",
      "selector": ".sv-chart .lbl",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.eyebrow",
      "selector": ".sv-card .ix, .sv-cn-foot span",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.size.button",
      "selector": ".sv-btn--amber",
      "prop": "fontSize",
      "type": "dimension"
    },
    {
      "path": "font.leading.h1",
      "selector": "h1",
      "prop": "lineHeight",
      "type": "number",
      "relativeTo": "fontSize"
    },
    {
      "path": "font.leading.body",
      "selector": ".sv-hero-right p",
      "prop": "lineHeight",
      "type": "number",
      "relativeTo": "fontSize"
    },
    {
      "path": "font.tracking.h1",
      "selector": "h1",
      "prop": "letterSpacing",
      "type": "dimension"
    },
    {
      "path": "font.tracking.eyebrow",
      "selector": ".sv-card .ix, .sv-cn-foot span",
      "prop": "letterSpacing",
      "type": "dimension"
    },
    {
      "path": "font.weight.heading",
      "selector": "h1, .sv-head h2, .sv-card h3",
      "prop": "fontWeight",
      "type": "fontWeight"
    },
    {
      "path": "font.weight.body",
      "selector": ".sv-hero-right p, .sv-card p",
      "prop": "fontWeight",
      "type": "fontWeight"
    },
    {
      "path": "font.weight.eyebrow",
      "selector": ".sv-card .ix",
      "prop": "fontWeight",
      "type": "fontWeight"
    },
    {
      "path": "space.section",
      "selector": "section.sv-pad",
      "prop": "paddingTop",
      "type": "dimension"
    },
    {
      "path": "space.section-bottom",
      "selector": "section.sv-pad",
      "prop": "paddingBottom",
      "type": "dimension"
    },
    {
      "path": "size.container",
      "selector": ".sv-wrap",
      "prop": "width",
      "type": "dimension"
    },
    {
      "path": "size.control.height",
      "selector": ".sv-hero-cta .sv-btn",
      "prop": "height",
      "type": "dimension"
    },
    {
      "path": "size.control.pad-x",
      "selector": ".sv-hero-cta .sv-btn",
      "prop": "paddingLeft",
      "type": "dimension"
    },
    {
      "path": "size.control.pad-y",
      "selector": ".sv-hero-cta .sv-btn",
      "prop": "paddingTop",
      "type": "dimension"
    },
    {
      "path": "size.control.height-sm",
      "selector": ".sv-nav-cta",
      "prop": "height",
      "type": "dimension"
    },
    {
      "path": "radius.button",
      "selector": ".sv-btn",
      "prop": "borderRadius",
      "type": "dimension"
    },
    {
      "path": "radius.panel",
      "selector": ".sv-console",
      "prop": "borderRadius",
      "type": "dimension"
    },
    {
      "path": "radius.chip",
      "selector": "ul.chips li",
      "prop": "borderRadius",
      "type": "dimension",
      "route": "/work/otee"
    },
    {
      "path": "radius.media",
      "selector": "figure.sv-fig .frame",
      "prop": "borderRadius",
      "type": "dimension",
      "route": "/work/otee"
    },
    {
      "path": "motion.duration.button",
      "selector": ".sv-btn",
      "prop": "transitionDuration",
      "type": "duration"
    },
    {
      "path": "motion.ease.button",
      "selector": ".sv-btn",
      "prop": "transitionTimingFunction",
      "type": "number"
    },
    {
      "path": "color.line-soft",
      "selector": ".sv-case-bar > div",
      "prop": "borderLeftColor",
      "type": "color",
      "route": "/work/otee"
    }
  ],
  "items": [
    {
      "id": "DS-01",
      "route": "/",
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "targets": [
        {
          "label": "cta",
          "selector": ".sv-hero-cta .sv-btn--amber"
        },
        {
          "label": "nav-contact",
          "selector": ".sv-nav-cta"
        },
        {
          "label": "bench-titlebar",
          "selector": ".sv-cn-bar"
        },
        {
          "label": "section-tag",
          "selector": "section.sv-inst-sec",
          "parts": [
            {
              "label": "tag",
              "pseudo": "::before"
            }
          ]
        }
      ]
    },
    {
      "id": "DS-02",
      "route": "/",
      "capture": [
        "bbox+computed",
        "viewport"
      ],
      "targets": [
        {
          "label": "body",
          "selector": "body"
        },
        {
          "label": "site-root",
          "selector": ".site-root"
        },
        {
          "label": "panel",
          "selector": ".sv-console"
        },
        {
          "label": "h1-ink",
          "selector": "h1"
        },
        {
          "label": "lede-ink-2",
          "selector": ".sv-hero-right p"
        },
        {
          "label": "index-ink-3",
          "selector": ".sv-card .ix"
        },
        {
          "label": "muted-clause",
          "selector": "h1 .sv-dim"
        },
        {
          "label": "hairline",
          "selector": ".sv-card"
        }
      ]
    },
    {
      "id": "DS-03",
      "route": "/",
      "viewports": [
        "desktop",
        "mobile"
      ],
      "capture": [
        "bbox+computed",
        "element@2x"
      ],
      "targets": [
        {
          "label": "h1",
          "selector": "h1"
        },
        {
          "label": "h2",
          "selector": ".sv-head h2"
        },
        {
          "label": "h3",
          "selector": ".sv-card h3"
        },
        {
          "label": "body",
          "selector": ".sv-hero-right p"
        },
        {
          "label": "caption",
          "selector": ".sv-chart .lbl"
        },
        {
          "label": "eyebrow",
          "selector": ".sv-card .ix"
        },
        {
          "label": "stat-number",
          "selector": ".sv-chart .sv-bar"
        }
      ]
    },
    {
      "id": "DS-04",
      "route": "/",
      "capture": [
        "bbox+computed",
        "element@2x"
      ],
      "targets": [
        {
          "label": "sans-heading",
          "selector": "h1"
        },
        {
          "label": "sans-body",
          "selector": ".sv-hero-right p"
        },
        {
          "label": "mono-role-eyebrow",
          "selector": ".sv-card .ix"
        },
        {
          "label": "mono-caption",
          "selector": ".sv-cn-foot"
        },
        {
          "label": "mono-console",
          "selector": ".sv-console .sv-cn-log, .sv-console pre, .sv-console [class*='log']"
        }
      ]
    },
    {
      "id": "DS-05",
      "route": "/",
      "capture": [
        "bbox+computed"
      ],
      "probes": [
        "paddingTop",
        "paddingBottom",
        "marginTop",
        "marginBottom",
        "height",
        "gap"
      ],
      "targets": [
        {
          "label": "section-ai-tools",
          "selector": "section.sv-wrap.sv-pad:not(.sv-outro)"
        },
        {
          "label": "section-teams",
          "selector": "section.sv-wrap.sv-pad:not(.sv-outro)",
          "nth": 1
        },
        {
          "label": "head-block",
          "selector": ".sv-head"
        },
        {
          "label": "chart-pin",
          "selector": ".sv-chart-pin"
        }
      ]
    },
    {
      "id": "DS-06",
      "route": "/",
      "keepMotion": true,
      "capture": [
        "bbox+computed"
      ],
      "probes": [
        "transition",
        "transitionDuration",
        "transitionTimingFunction",
        "transitionProperty",
        "transform",
        "animation",
        "animationDuration"
      ],
      "targets": [
        {
          "label": "cta",
          "selector": ".sv-hero-cta .sv-btn--amber"
        },
        {
          "label": "ghost",
          "selector": ".sv-hero-cta .sv-btn--ghost"
        },
        {
          "label": "card",
          "selector": ".sv-card"
        },
        {
          "label": "reveal",
          "selector": ".sv-rv"
        },
        {
          "label": "bar-fill",
          "selector": ".sv-chart .sv-bar .fill"
        }
      ]
    },
    {
      "id": "DS-07",
      "route": "/",
      "capture": [
        "bbox+computed",
        "element@2x"
      ],
      "probes": [
        "height",
        "padding",
        "borderRadius",
        "border",
        "fontSize",
        "fontWeight",
        "letterSpacing",
        "gap",
        "minHeight"
      ],
      "targets": [
        {
          "label": "cta",
          "selector": ".sv-hero-cta .sv-btn--amber"
        },
        {
          "label": "ghost",
          "selector": ".sv-hero-cta .sv-btn--ghost"
        },
        {
          "label": "nav-cta",
          "selector": ".sv-nav-cta"
        },
        {
          "label": "chip",
          "selector": ".sv-console span.tag"
        },
        {
          "label": "console-button",
          "selector": ".sv-console button",
          "nth": 4
        },
        {
          "label": "panel",
          "selector": ".sv-console"
        }
      ]
    },
    {
      "id": "DS-08",
      "route": "/",
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "targets": [
        {
          "label": "h1",
          "selector": "h1.sv-lines",
          "parts": [
            {
              "label": "muted-clause",
              "selector": ".sv-dim"
            }
          ]
        },
        {
          "label": "h2-numbers",
          "selector": ".sv-chart-pin h2",
          "parts": [
            {
              "label": "muted-clause",
              "selector": ".sv-dim"
            }
          ]
        },
        {
          "label": "h2-teams",
          "selector": ".sv-head h2",
          "nth": 1,
          "parts": [
            {
              "label": "muted-clause",
              "selector": ".sv-dim"
            }
          ]
        }
      ]
    },
    {
      "id": "DS-09",
      "route": "/",
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "targets": [
        {
          "label": "employer-role",
          "selector": ".sv-card .role"
        },
        {
          "label": "index-code",
          "selector": ".sv-card .ix"
        },
        {
          "label": "figure-caption",
          "selector": ".sv-cn-foot"
        },
        {
          "label": "rail-sublabel",
          "selector": ".sv-cn-side .item small, .sv-cn-side .item span",
          "nth": 1
        },
        {
          "label": "section-tag",
          "selector": "section.sv-inst-sec",
          "parts": [
            {
              "label": "tag",
              "pseudo": "::before"
            }
          ]
        }
      ]
    },
    {
      "id": "DS-10",
      "route": "/",
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "targets": [
        {
          "label": "employer-index",
          "selector": ".sv-card .ix"
        },
        {
          "label": "employer-card",
          "selector": ".sv-card",
          "parts": [
            {
              "label": "ix",
              "selector": ".ix"
            },
            {
              "label": "title",
              "selector": "h3"
            }
          ]
        },
        {
          "label": "nav-index",
          "selector": ".sv-nav-sheet .ix"
        },
        {
          "label": "hero-index",
          "selector": ".sv-hero .ix"
        }
      ]
    },
    {
      "id": "DS-11",
      "route": "/",
      "capture": [
        "viewport",
        "bbox+computed"
      ],
      "probes": [
        "width",
        "maxWidth",
        "marginLeft",
        "marginRight",
        "paddingLeft",
        "paddingRight",
        "borderLeft",
        "borderRight",
        "borderTop",
        "backgroundImage",
        "backgroundSize"
      ],
      "targets": [
        {
          "label": "wrap",
          "selector": ".sv-wrap"
        },
        {
          "label": "ruled",
          "selector": ".sv-ruled"
        },
        {
          "label": "site-root",
          "selector": ".site-root"
        }
      ]
    },
    {
      "id": "DS-12",
      "route": "/",
      "viewports": [
        "desktop",
        "mobile"
      ],
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "probes": [
        "content",
        "color",
        "backgroundColor",
        "fontFamily",
        "fontSize",
        "fontWeight",
        "letterSpacing",
        "textTransform",
        "padding",
        "position",
        "top",
        "left",
        "right",
        "borderTop",
        "borderRight",
        "width",
        "height"
      ],
      "targets": [
        {
          "label": "opener-tracks",
          "selector": "section.sv-inst-sec",
          "parts": [
            {
              "label": "tag",
              "pseudo": "::before"
            },
            {
              "label": "bracket",
              "pseudo": "::after"
            }
          ]
        },
        {
          "label": "opener-numbers",
          "selector": ".sv-pin-mark",
          "parts": [
            {
              "label": "tag",
              "pseudo": "::before"
            },
            {
              "label": "bracket",
              "pseudo": "::after"
            }
          ]
        },
        {
          "label": "opener-teams",
          "selector": "section.sv-wrap.sv-pad:not(.sv-outro)",
          "nth": 1,
          "parts": [
            {
              "label": "tag",
              "pseudo": "::before"
            },
            {
              "label": "bracket",
              "pseudo": "::after"
            },
            {
              "label": "heading",
              "selector": ".sv-head h2"
            }
          ]
        },
        {
          "label": "head-block",
          "selector": ".sv-head"
        }
      ]
    },
    {
      "id": "DS-13",
      "route": "/",
      "capture": [
        "element@2x",
        "bbox+computed"
      ],
      "probes": [
        "display",
        "gridTemplateColumns",
        "gap",
        "columnGap",
        "alignItems",
        "maxWidth",
        "width",
        "paddingBottom",
        "borderBottom"
      ],
      "targets": [
        {
          "label": "head-ai",
          "selector": ".sv-head",
          "parts": [
            {
              "label": "heading",
              "selector": "h2"
            },
            {
              "label": "body",
              "selector": "p"
            }
          ]
        },
        {
          "label": "head-teams",
          "selector": ".sv-head",
          "nth": 1,
          "parts": [
            {
              "label": "heading",
              "selector": "h2"
            },
            {
              "label": "body",
              "selector": "p"
            }
          ]
        }
      ]
    },
    {
      "id": "DS-14",
      "route": "/work/otee",
      "capture": [
        "frames",
        "element@2x",
        "bbox+computed"
      ],
      "frames": {
        "count": 6,
        "intervalMs": 300,
        "scroll": {
          "from": "target-top",
          "to": "bottom"
        }
      },
      "probes": [
        "position",
        "top",
        "left",
        "width",
        "fontFamily",
        "fontSize",
        "letterSpacing",
        "color",
        "gap",
        "display",
        "flexDirection"
      ],
      "targets": [
        {
          "label": "chapter-rail",
          "selector": "nav.sv-ch-rail",
          "parts": [
            {
              "label": "item",
              "selector": "a, li, span"
            }
          ]
        },
        {
          "label": "sheet",
          "selector": ".sv-case-sheet"
        }
      ]
    },
    {
      "id": "DS-15",
      "route": "/",
      "capture": [
        "element@2x",
        "states",
        "bbox+computed"
      ],
      "states": [
        "hover"
      ],
      "probes": [
        "display",
        "gap",
        "alignItems",
        "justifyContent",
        "height",
        "padding",
        "borderBottom",
        "backgroundColor",
        "position",
        "fontFamily",
