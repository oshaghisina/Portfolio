    "webFull": "Carsparency Pro on desktop — {group}: {label}, the whole page"
  },
  "masked": {
    "contact": ", with the sample email and phone number pixelated",
    "profile": ", with the sample contact details pixelated and the profile photo blurred",
    "document": ", with the sample payment screenshot blurred"
  }
