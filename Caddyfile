{
	email sinaoshaghi@gmail.com
	# Certs from acme.sh DNS-01 (manual). HTTP-01 still blocked from abroad.
	auto_https off
}

http://www.sinaoshaghi.com {
	redir https://sinaoshaghi.com{uri} permanent
}

http://www.sinaoshaghi.ir {
	redir https://sinaoshaghi.ir{uri} permanent
}

http://sinaoshaghi.com, http://sinaoshaghi.ir {
	redir https://{host}{uri} permanent
}

www.sinaoshaghi.com {
	tls /etc/caddy/certs/fullchain.cer /etc/caddy/certs/privkey.pem
	redir https://sinaoshaghi.com{uri} permanent
}

www.sinaoshaghi.ir {
	tls /etc/caddy/certs/fullchain.cer /etc/caddy/certs/privkey.pem
	redir https://sinaoshaghi.ir{uri} permanent
}

sinaoshaghi.com, sinaoshaghi.ir {
	tls /etc/caddy/certs/fullchain.cer /etc/caddy/certs/privkey.pem
	encode gzip zstd
	reverse_proxy 127.0.0.1:3000
}
