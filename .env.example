# Database connection string
DATABASE_URL=mongodb://127.0.0.1:27017/portfolio-cms

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links, Open Graph, and postbuild sitemap/robots.
# No trailing slash. Use http://localhost:3000 locally; set the real public origin for production builds.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Payload admin for production upserts (`pnpm create-admin`). Fill in local .env only.
# PROD_ADMIN_EMAIL=
# PROD_ADMIN_PASSWORD=
# PROD_ADMIN_NAME=

# Arvan Object Storage (S3-compatible). Enabled only when both S3_BUCKET and
# S3_PUBLIC_URL are set; otherwise Payload keeps writing to public/media.
# Use Object Storage access keys — not the CDN / napi API key.
# S3_BUCKET=sinaoshaghi-portfolio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ir-thr-at1
# S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# Public base URL for objects (no trailing slash). Virtual-host or custom domain.
# S3_PUBLIC_URL=https://sinaoshaghi-portfolio.s3.ir-thr-at1.arvanstorage.ir

# Cloudflare Tunnel (production VPS only). Zero Trust → Networks → Tunnels →
# portfolio-iran → copy token into /srv/portfolio/.env.cloudflared as:
#   TUNNEL_TOKEN=eyJ…
# chmod 600. Do not put the token in git or in Compose ${…} interpolation ($ in JWTs breaks).
# Powers sinaoshaghi.com; .ir stays on Arvan CDN.
